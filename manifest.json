{
  "manifest_version": 3,
  "name": "Playwright Trace Recorder",
  "version": "0.2.0",
  "description": "Record browser interactions as Playwright traces. Saved locally, no backend needed. Download and replay at trace.playwright.dev.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "notifications",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Playwright Trace Recorder"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "devtools_page": "src/dev_panel.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
